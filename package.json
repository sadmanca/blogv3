{
  "name": "astro-erudite",
  "type": "module",
  "version": "1.6.3",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:verbose": "astro dev --verbose",
    "dev:profile": "bun --inspect astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "astro": "astro",
    "prettier": "prettier --write **/*.{ts,tsx,css,astro} --ignore-path .gitignore"
  },
  "dependencies": {
    "@astrojs/check": "0.9.7",
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/compiler-rs": "^0.1.4",
    "@astrojs/markdown-remark": "7.0.0",
    "@astrojs/mdx": "5.0.0",
    "@astrojs/react": "5.0.0",
    "@astrojs/rss": "4.0.17",
    "@astrojs/sitemap": "3.7.1",
    "@expressive-code/plugin-collapsible-sections": "^0.40.2",
    "@expressive-code/plugin-line-numbers": "^0.40.2",
    "@iconify-json/lucide": "^1.2.26",
    "@iconify-json/simple-icons": "^1.2.46",
    "@iconify-json/tabler": "^1.2.19",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@shikijs/rehype": "^3.4.0",
    "@swup/parallel-plugin": "^0.4",
    "@swup/preload-plugin": "^3.2.11",
    "@swup/progress-plugin": "^3",
    "@tailwindcss/vite": "^4.0.7",
    "@twodft/astro-icon": "^1.2.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "19.1.0",
    "astro": "^6.4.0",
    "astro-loader-goodreads": "1.3.1",
    "astro-webrings": "^0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^26.1.0",
    "limiter": "^3.0.0",
    "lucide-react": "^0.469.0",
    "medium-zoom": "^1.1.0",
    "patch-package": "^8.0.0",
    "radix-ui": "^1.4.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "rehype-document": "^7.0.3",
    "rehype-expressive-code": "^0.40.2",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "remark-emoji": "^5.0.1",
    "remark-math": "^6.0.0",
    "swup": "^4.0.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@iconify-icons/tabler": "^1.2.95",
    "@iconify-json/clarity": "^1.2.2",
    "@types/jsdom": "^21.1.7",
    "@types/xml2js": "^0.4.14",
    "prettier": "^3.5.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-astro-organize-imports": "^0.4.11",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tw-animate-css": "^1.3.5",
    "vite": "^7.3.5",
    "wrangler": "^4.83.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-tailwindcss",
      "prettier-plugin-astro-organize-imports"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  }
}
