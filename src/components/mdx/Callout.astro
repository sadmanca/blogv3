---
import { Icon } from '@twodft/astro-icon/components'

interface Props {
  type?: 'default' | 'info' | 'warning' | 'flag' | 'destructive'
  icon?: string
  iconColor?: string
  classes?: string
}

const { type = 'default', icon: customIcon, iconColor: customIconColor, classes: customClasses } = Astro.props

const typeMapping = {
  default: {
    icon: 'lucide:lightbulb',
    classes: 'bg-primary/20',
    iconColor: 'text-blue-700 dark:text-blue-600',
  },
  info: {
    icon: 'lucide:info',
    classes: 'bg-secondary/50',
    iconColor: 'text-blue-700 dark:text-blue-600',
  },
  warning: {
    icon: 'lucide:alert-triangle',
    classes:
      'border-yellow-600/100 bg-yellow-100/40 dark:border-yellow-400/100 dark:bg-yellow-900/40',
    iconColor: 'text-yellow-700 dark:text-yellow-400',
  },
  flag: {
    icon: 'lucide:flag',
    classes: 'bg-primary/20 justify-center',
    iconColor: 'text-primary',
  },
  destructive: {
    icon: 'lucide:alert-octagon',
    classes: 'border-red-700/100 bg-red-100/70 dark:border-red-400/100 dark:bg-red-900/40',
    iconColor: 'text-red-700 dark:text-red-400',
  },
}

const { icon, classes, iconColor } = typeMapping[type]
const finalIcon = customIcon || icon
const finalClasses = customClasses || classes
const finalIconColor = customIconColor || iconColor
---

{/* `items-start` and the icon's `h-[1lh]` are what align the icon to the
    first line of text: 1lh resolves to the inherited prose line-height, the
    same one the first paragraph uses, so the icon centres on that line box
    whether the callout is one line or twenty. Both live in the hard-coded
    half of the class string — `classes` replaces the type defaults, so a
    call site can never strip them. Interior spacing comes from the
    `.callout` contract in typography.css, not from margins here. */}
<div class={`relative my-6 flex items-start gap-4 rounded-xl border-2 p-4 ${finalClasses}`}>
  <span
    class="pointer-events-none flex h-[1lh] shrink-0 items-center justify-center select-none"
    aria-hidden="true"
  >
    <Icon name={finalIcon} size={27} class={finalIconColor} />
  </span>
  {/* `flex-1` is withheld from `flag`, whose default classes add
      `justify-center` to centre the icon+content pair as a group. */}
  <div class:list={['callout min-w-0', type !== 'flag' && 'flex-1']}>
    <slot />
  </div>
</div>
