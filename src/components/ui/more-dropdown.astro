---
import Link from '@/components/link.astro'
import { Icon } from '@twodft/astro-icon/components'

// Define menu items for easy maintenance and expansion
const menuItems = [
  { label: 'Uses', href: '/uses', icon: 'lucide:laptop' },
  { label: 'Reading', href: '/reading', icon: 'lucide:book' },
  { label: 'Ukulele', href: '/ukulele', icon: 'lucide:music-4' },
  { label: 'PEY', href: '/blog/pey-coop-jobs-at-uoft', icon: 'lucide:briefcase' },
  { label: 'Work Study', href: '/blog/uoft-work-study-jobs-2025-2026', icon: 'lucide:school' },
]
---

<!-- 
  Using <details> element for progressive enhancement:
  - Works without JavaScript (native click-to-toggle)
  - Enhanced with JS for hover behavior on desktop
  - Accessible by default with proper keyboard support
-->
<details class="more-dropdown relative inline-block ml-2" id="more-dropdown">
  <summary 
    class="more-dropdown-trigger flex items-center text-sm capitalize text-foreground/60 transition-colors hover:text-foreground/80 cursor-pointer list-none [&::-webkit-details-marker]:hidden"
  >
    More
    <Icon name="lucide:chevron-down" class="chevron-icon ml-1 size-4 transition-transform duration-300" style="margin-top: 2.5px;" />
  </summary>

  <!-- Dropdown Menu -->
  <div 
    class="dropdown-menu absolute right-0 mt-1 z-50 min-w-[8rem] origin-top-right rounded-md bg-background border shadow-md p-1"
  >
    {menuItems.map(item => (
      <div class="block">
        <Link 
          href={item.href}
          class="flex items-center transition-colors duration-300 ease-in-out hover:bg-accent hover:text-accent-foreground px-2 py-1.5 text-sm rounded-sm w-full"
        >
          <Icon name={item.icon} class="mr-2 size-4" />
          {item.label}
        </Link>
      </div>
    ))}
  </div>
</details>

<style>
  /* Base styles - works without JS */
  .more-dropdown .dropdown-menu {
    display: none;
  }
  
  .more-dropdown[open] .dropdown-menu {
    display: block;
  }
  
  .more-dropdown[open] .chevron-icon {
    transform: rotate(180deg);
  }
</style>

<script>
  function initMoreDropdown() {
    const details = document.getElementById('more-dropdown') as HTMLDetailsElement | null;
    if (!details) return;

    const summary = details.querySelector('summary');
    if (!summary) return;

    // Track if dropdown was opened by click (sticky) vs hover
    let clickLocked = false;
    let hoverTimeout: ReturnType<typeof setTimeout> | null = null;

    const openDropdown = () => {
      details.open = true;
    };

    const closeDropdown = () => {
      details.open = false;
      clickLocked = false;
    };

    // Handle summary click - toggle sticky state
    summary.addEventListener('click', (e) => {
      e.preventDefault();
      
      if (details.open && clickLocked) {
        // Already open and locked by click - close it
        closeDropdown();
      } else if (details.open && !clickLocked) {
        // Open by hover, now clicking - lock it open
        clickLocked = true;
      } else {
        // Closed - open and lock
        openDropdown();
        clickLocked = true;
      }
    });

    // Hover functionality (desktop only, uses matchMedia for proper detection)
    const isHoverDevice = window.matchMedia('(hover: hover)').matches;

    if (isHoverDevice) {
      details.addEventListener('mouseenter', () => {
        if (hoverTimeout) {
          clearTimeout(hoverTimeout);
          hoverTimeout = null;
        }
        if (!clickLocked) {
          openDropdown();
        }
      });

      details.addEventListener('mouseleave', () => {
        if (!clickLocked) {
          hoverTimeout = setTimeout(() => {
            closeDropdown();
          }, 150);
        }
      });
    }

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (!details.contains(e.target as Node) && details.open) {
        closeDropdown();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && details.open) {
        closeDropdown();
        summary.focus();
      }
    });
  }

  // Initialize on page load
  initMoreDropdown();
</script>
