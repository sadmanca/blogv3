---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
import { formatDate } from '@/lib/utils'
import { Icon } from '@twodft/astro-icon/components'
import { getCollection, getEntry, render as renderContent } from 'astro:content'
import { render as renderScore } from 'astro-lilypond'

export async function getStaticPaths() {
  const songs = await getCollection('ukulele')
  return songs.map((song) => ({
    params: { slug: song.id },
    props: song,
  }))
}

const song = Astro.props
const { Content } = await renderContent(song)

const scoreEntry = await getEntry('scores', song.data.score)
const score = scoreEntry
  ? await renderScore(
      { ...scoreEntry.data, sourceName: scoreEntry.data.sourceName ?? scoreEntry.id },
      { pdf: true },
    )
  : null
// AstroComponentFactory is a valid template tag; the cast just removes
// the `| undefined` union that `score?.Score` would produce. Rendered only
// when `score` is non-null below.
const Score = score?.Score as import('astro/runtime/server/index.js').AstroComponentFactory
const pdf = score?.pdf

const songs = (await getCollection('ukulele')).sort((a, b) => {
  const orderDiff = (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER)
  if (orderDiff !== 0) return orderDiff
  if (a.data.date && b.data.date) return b.data.date.valueOf() - a.data.date.valueOf()
  return a.data.title.localeCompare(b.data.title)
})
const currentIndex = songs.findIndex((s) => s.id === song.id)
const prevSong = currentIndex > 0 ? songs[currentIndex - 1] : null
const nextSong = currentIndex < songs.length - 1 ? songs[currentIndex + 1] : null
---

<Layout>
  <PageHead slot="head" title={song.data.title} description={song.data.description} />

  <section class="mx-auto max-w-3xl px-4">
    <Breadcrumbs
      items={[
        { href: '/ukulele', label: 'Ukulele', icon: 'lucide:music-4' },
        { href: `/ukulele/${song.id}`, label: song.data.title, icon: 'lucide:music' },
      ]}
    />

    <div class="mb-8 text-center">
      <h1 class="mb-2 text-6xl leading-none font-black sm:text-4xl">
        {song.data.title}
      </h1>
      <p class="text-primary bg-ring/30 lg:rounded-full rounded-xl text-lg font-normal leading-6 mx-14 px-6 py-3 mb-4">
        {song.data.artist}
      </p>
      <div class="text-muted-foreground flex flex-wrap items-center justify-center gap-2 text-sm">
        {song.data.difficulty && (
          <span class="flex items-center gap-x-1.5">
            <Icon name="lucide:music-4" class="size-3" />
            {song.data.difficulty}
          </span>
        )}
        {song.data.key && (
          <span class="flex items-center gap-x-1.5">
            <Icon name="lucide:music" class="size-3" />
            Key of {song.data.key}
          </span>
        )}
        {song.data.date && (
          <span class="flex items-center gap-x-1.5">
            <Icon name="lucide:calendar" class="size-3" />
            {formatDate(song.data.date)}
          </span>
        )}
        {song.data.youtube && (
          <a
            href={song.data.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-x-1.5 text-foreground underline"
          >
            <Icon name="lucide:youtube" class="size-3" />
            Listen
          </a>
        )}
      </div>
    </div>

    {
      Content && (
        <article class="prose mx-auto max-w-xl">
          <Content />
        </article>
      )
    }

    {
      score ? (
        <div class="mt-8">
          <Score />
          {
            pdf && (
              <div class="mt-4 flex justify-center">
                <a
                  href={pdf.src}
                  download
                  class="inline-flex items-center gap-x-2 rounded-md border px-4 py-2 text-sm font-medium transition-colors hover:bg-secondary/50"
                >
                  <Icon name="lucide:file-down" class="size-4" />
                  Download PDF
                </a>
              </div>
            )
          }
        </div>
      ) : (
        <p class="text-muted-foreground mt-8 text-center text-sm">
          Tablature for this song hasn't been added yet.
        </p>
      )
    }

    <div class="mt-12 flex items-center justify-between border-t pt-6 text-sm">
      {prevSong ? (
        <Link href={`/ukulele/${prevSong.id}`} class="text-muted-foreground hover:text-foreground transition-colors">
          ← {prevSong.data.title}
        </Link>
      ) : (
        <span />
      )}
      {nextSong ? (
        <Link href={`/ukulele/${nextSong.id}`} class="text-muted-foreground hover:text-foreground transition-colors">
          {nextSong.data.title} →
        </Link>
      ) : (
        <span />
      )}
    </div>
  </section>
</Layout>
