---
import '@/styles/global.css'
import '@/styles/typography.css'

import Footer from '@/components/Footer.astro'
import Head from '@/components/head.astro'
import Header from '@/components/header.astro'
import MediumZoom from '@/components/MediumZoom.astro'
import Banner from '@/components/banner.astro'
import { SITE } from '@/consts'
import { cn } from '@/lib/utils'
import { getAllPosts } from '@/lib/data-utils'

const allPosts = await getAllPosts()
const latestPost = allPosts.length > 0 ? allPosts[0] : null

interface Props {
  class?: string
}

const { class: className } = Astro.props

const isDev = import.meta.env.DEV; // true when in development mode
---

<!doctype html>
<html class="bg-background text-foreground" lang={SITE.locale} transition:animate="none">
  <!-- Google tag (gtag.js) -->
  {!isDev && (
    <script is:inline>
      // Function to load Google Analytics
      function loadGoogleAnalytics() {
        if (document.querySelector('script[data-ga-loaded="true"]')) return;
        
        // Create the GTM script
        const gtmScript = document.createElement('script');
        gtmScript.src = "https://www.googletagmanager.com/gtag/js?id=G-Q095PB1G6R";
        gtmScript.async = true;
        gtmScript.dataset.gaLoaded = "true";
        
        // Create the initialization script
        const inlineScript = document.createElement('script');
        inlineScript.textContent = `
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag("js", new Date());
          gtag("config", "G-Q095PB1G6R");
        `;
        
        // Append scripts to the document
        document.head.appendChild(gtmScript);
        document.head.appendChild(inlineScript);
      }

      // Load GA after the page becomes interactive
      if (document.readyState !== 'loading') {
        if ('requestIdleCallback' in window) {
          requestIdleCallback(() => loadGoogleAnalytics());
        } else {
          setTimeout(loadGoogleAnalytics, 1000);
        }
      } else {
        document.addEventListener('DOMContentLoaded', function() {
          if ('requestIdleCallback' in window) {
            requestIdleCallback(() => loadGoogleAnalytics());
          } else {
            setTimeout(loadGoogleAnalytics, 1000);
          }
        });
      }

      // Track pageviews on View Transitions navigation
      document.addEventListener('astro:after-swap', function() {
        if (typeof gtag !== 'undefined') {
          gtag('config', 'G-Q095PB1G6R', {
            page_path: window.location.pathname,
            page_title: document.title,
          });
        }
      });
    </script>
  )}
  <!-- End Google tag (gtag.js) -->
  
  <!-- Service Worker Registration -->
  <script is:inline>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function() {
        navigator.serviceWorker.register('/sw.js')
          .then(function(registration) {
            console.log('SW registered: ', registration);
          })
          .catch(function(registrationError) {
            console.log('SW registration failed: ', registrationError);
          });
      });
    }
  </script>
  
  <!-- Performance monitoring -->
  {!isDev && (
    <script src="/performance.js" defer></script>
  )}
  
  <MediumZoom />
  <Head>
    <slot name="head" />
  </Head>
  <body>
    <div class="flex h-fit min-h-screen flex-col gap-y-1 font-sans">
      {latestPost && (
        <Banner
          type={`Latest post: `}
          text={`${latestPost.data.title}`}
          link={`/blog/${latestPost.id}`}
        />
      )}
      <div
        class="sticky top-0 z-50 divide-y xl:divide-none"
      >
        <Header />
        <div>
          <slot name="subposts-navigation" />
          <slot name="table-of-contents" />
        </div>
      </div>
      <main class="grow" transition:animate="none">
        <div class={cn('mx-auto flex grow flex-col gap-y-6 px-4', className)}>
          <slot />
        </div>
      </main>
      <Footer />
    <div aria-hidden="true" class="z-20 pointer-events-none fixed inset-x-0 bottom-0 z-10 h-16 bg-gradient-to-b from-transparent to-[var(--background))] dark:bg-gradient-to-b dark:from-transparent dark:to-[var(--background))]"></div>
    </div>
    <div class="mb-4"/>
    <script>
      function hideMobileTOC() {
        const tocContainer = document.getElementById('mobile-toc-container');
        const path = window.location.pathname;

        // Matches /blog or /blog/ or /blog/123 or /blog/123/
        const hideBlogListOrNumberRegex = /^\/blog(\/(\d+)\/?)?$/;

        // Show TOC only if NOT blog listing/numbered page AND it's /blog/some-text or /about
        const isAboutPage = path === "/about";
        const isBlogTextPage = path.startsWith("/blog/") && !hideBlogListOrNumberRegex.test(path);

        if (tocContainer) {
          const isMobile = window.innerWidth < 1280; // Matches XL breakpoint
          if (isAboutPage || isBlogTextPage) {
            tocContainer.style.setProperty('display', isMobile ? '' : 'none', 'important');
            console.log('Mobile TOC shown for blog post or about page');
          } else {
            tocContainer.style.setProperty('display', 'none', 'important');
            console.log('Mobile TOC hidden for blog list or numbered pages');
          }
        }
      }

      // Initialize immediately if DOM ready
      if (document.readyState !== 'loading') {
        hideMobileTOC();
      }

      window.addEventListener('resize', hideMobileTOC);

      // Re-run TOC visibility check after View Transitions navigation
      document.addEventListener('astro:after-swap', hideMobileTOC);
  </script>
  </body>
</html>
